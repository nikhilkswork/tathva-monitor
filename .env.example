# HackRadar Environment Configuration

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Default Telegram Chat ID / Channel ID for notifications
TELEGRAM_CHAT_ID=your_chat_id_here

# Database URL (defaults to local SQLite database: sqlite:///hackradar.db)
# For production PostgreSQL / Supabase, use:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///hackradar.db

# Admin Dashboard Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hackradar_secure_password_123

# HTTP Scraping Settings
REQUEST_TIMEOUT=15
MONITOR_INTERVAL_MINUTES=30
