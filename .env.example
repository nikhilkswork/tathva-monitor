# =====================================================================
# HackRadar Production & Development Environment Configuration
# =====================================================================

# 1. Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# 2. Default Telegram Chat ID / Channel ID for notifications
# (Find yours by messaging @userinfobot or sending /start to your bot)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 3. Database URL (PostgreSQL in production, SQLite fallback in local dev)
#
# Option A — Supabase (Direct or Session Pooler on Port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option B — Supabase (Transaction Pooler on Port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option C — Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql+psycopg://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
#
# Option D — Local / Free SQLite (default fallback):
DATABASE_URL=sqlite:///hackradar.db

# 4. Admin Dashboard Credentials (for /dashboard and protected API routes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hackradar_secure_password_123

# 5. Monitoring & Scraping Settings
REQUEST_TIMEOUT=15
MONITOR_INTERVAL_MINUTES=30
